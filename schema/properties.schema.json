{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/plc-benchmark-suite/properties.schema.json",
  "title": "property file (props.yaml)",
  "type": "object",
  "required": ["format_version", "properties"],
  "additionalProperties": false,
  "properties": {
    "format_version": { "type": "string" },
    "properties": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/property" }
    }
  },
  "$defs": {
    "property": {
      "type": "object",
      "required": ["id", "kind", "justification"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^P[0-9]+$" },
        "kind": {
          "type": "string",
          "enum": ["invariant", "mutual_exclusion", "absence", "reachability", "assertion", "termination"]
        },
        "expression": { "type": "string" },
        "variables": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "subtype": { "type": "string", "enum": ["overflow", "div_zero", "array_bounds"] },
        "location": { "type": "string" },
        "justification": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "mutual_exclusion" } } },
          "then": { "required": ["variables"] }
        },
        {
          "if": { "properties": { "kind": { "enum": ["invariant", "reachability"] } } },
          "then": { "required": ["expression"] }
        },
        {
          "if": { "properties": { "kind": { "const": "absence" } } },
          "then": { "required": ["subtype"] }
        }
      ]
    }
  }
}
