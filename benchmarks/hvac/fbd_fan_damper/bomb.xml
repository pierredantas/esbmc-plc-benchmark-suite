            <variable name="damper_open"><type><BOOL /></type></variable>
            <variable name="smoke"><type><BOOL /></type></variable>
          </inputVars>
          <outputVars>
            <variable name="fan"><type><BOOL /></type></variable>
          </outputVars>
        </interface>
        <body>
          <FBD>
            <inVariable localId="1" height="20" width="80">
              <position x="20" y="20" />
