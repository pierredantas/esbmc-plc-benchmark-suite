  <types>
    <dataTypes />
    <pous>
      <pou name="drive" pouType="program">
        <interface>
          <inputVars>
            <variable name="fwd"><type><BOOL /></type></variable>
            <variable name="rev"><type><BOOL /></type></variable>
            <variable name="maint"><type><BOOL /></type></variable>
          </inputVars>
          <outputVars>
            <variable name="Motor_A"><type><BOOL /></type></variable>
            <variable name="Motor_B"><type><BOOL /></type></variable>
          </outputVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Motor_A := FALSE;
Motor_B := FALSE;
IF fwd AND NOT rev THEN
  Motor_A := TRUE;
ELSIF rev THEN
  Motor_B := TRUE;
END_IF;
IF fwd AND rev AND maint THEN
  Motor_A := TRUE;
  Motor_B := TRUE;
END_IF;</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
