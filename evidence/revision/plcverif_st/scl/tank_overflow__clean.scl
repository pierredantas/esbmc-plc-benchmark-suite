FUNCTION_BLOCK TANK
  VAR_INPUT
    level_high : BOOL;   
    start : BOOL;   
  END_VAR
  VAR
    pump : BOOL;   
  END_VAR

BEGIN
IF start AND NOT level_high THEN
    pump := TRUE;
  END_IF;

  
  IF level_high THEN
    pump := FALSE;
  END_IF;
  //#ASSERT NOT (pump AND level_high) : P1
  //#ASSERT NOT (pump AND level_high) : P2
END_FUNCTION_BLOCK
