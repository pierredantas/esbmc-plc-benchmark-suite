FUNCTION_BLOCK PRESS
  VAR_INPUT
    LH : BOOL;
    RH : BOOL;
  END_VAR
  VAR_OUTPUT
    BothOff : BOOL;
    Armed   : BOOL;
    Stroke  : BOOL;
  END_VAR

BEGIN
BothOff := NOT LH AND NOT RH;
  Armed := (Armed OR BothOff) AND NOT Stroke;
  Stroke := (Stroke OR Armed) AND LH AND RH;
  //#ASSERT NOT Stroke OR (LH AND RH) : P1
END_FUNCTION_BLOCK
