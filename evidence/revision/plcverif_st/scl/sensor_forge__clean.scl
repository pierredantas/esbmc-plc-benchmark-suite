FUNCTION_BLOCK RELIEF
  VAR_INPUT
    over_press : BOOL;   
  END_VAR
  VAR
    valve_open : BOOL; 
    reported_open : BOOL; 
  END_VAR

BEGIN
IF over_press THEN
    valve_open := TRUE;
  ELSE
    valve_open := FALSE;
  END_IF;

  
  reported_open := valve_open;
  //#ASSERT reported_open = valve_open : P1
  //#ASSERT NOT (reported_open AND NOT valve_open) : P2
END_FUNCTION_BLOCK
