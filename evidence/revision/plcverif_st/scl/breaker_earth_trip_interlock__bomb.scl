FUNCTION_BLOCK BREAKER_CONTROL
  VAR_INPUT
    earth_switch_closed : BOOL;
    trip_latched : BOOL;
    close_request : BOOL;
  END_VAR
  VAR
    closing_coil : BOOL;
  END_VAR

BEGIN
IF earth_switch_closed THEN
    closing_coil := FALSE;
  ELSIF close_request THEN
    closing_coil := TRUE;
  ELSIF trip_latched THEN
    closing_coil := FALSE;
  ELSE
    closing_coil := FALSE;
  END_IF;
  //#ASSERT NOT (closing_coil AND earth_switch_closed) : P1
  //#ASSERT NOT (closing_coil AND trip_latched) : P2
  //#ASSERT NOT (closing_coil AND trip_latched) : P3
END_FUNCTION_BLOCK
