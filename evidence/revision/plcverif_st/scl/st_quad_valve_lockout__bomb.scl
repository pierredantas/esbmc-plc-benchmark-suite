FUNCTION_BLOCK QUAD_VALVE
  VAR_INPUT
    sel_1 : BOOL;
    sel_2 : BOOL;
    sel_3 : BOOL;
    sel_4 : BOOL;
    fast_flush : BOOL;
  END_VAR
  VAR
    valve_1 : BOOL;
    valve_2 : BOOL;
    valve_3 : BOOL;
    valve_4 : BOOL;
  END_VAR

BEGIN
valve_1 := FALSE;
  valve_2 := FALSE;
  valve_3 := FALSE;
  valve_4 := FALSE;

  IF sel_1 THEN
    valve_1 := TRUE;
  ELSIF sel_2 THEN
    valve_2 := TRUE;
  ELSIF sel_4 THEN
    valve_4 := TRUE;
  END_IF;

  IF fast_flush THEN
    valve_3 := TRUE;
  END_IF;
  //#ASSERT NOT (valve_1 AND valve_2 AND valve_3 AND valve_4) : P1
  //#ASSERT NOT (valve_1 AND valve_3) : P2
END_FUNCTION_BLOCK
