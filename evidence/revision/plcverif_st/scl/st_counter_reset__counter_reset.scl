FUNCTION_BLOCK DRIVE
  VAR_INPUT
    Reset : BOOL;
    ResetCounterValue : INT;
  END_VAR
  VAR_OUTPUT
    OUT : INT;
  END_VAR
  VAR
    Cnt : INT;
  END_VAR

BEGIN
IF Reset THEN
    Cnt := ResetCounterValue;
  ELSE
    Cnt := Cnt + 1;
  END_IF;

  OUT := Cnt;
  //#ASSERT NOT Reset OR (OUT = ResetCounterValue) : P1
END_FUNCTION_BLOCK
