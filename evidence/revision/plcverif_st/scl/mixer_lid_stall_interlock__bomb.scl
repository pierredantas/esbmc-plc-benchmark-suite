FUNCTION_BLOCK MIXER_CONTROL
  VAR_INPUT
    lid_open : BOOL;
    agitator_stalled : BOOL;
    run_request : BOOL;
    heat_request : BOOL;
  END_VAR
  VAR
    agitator_on : BOOL;
    heater_on : BOOL;
  END_VAR

BEGIN
IF lid_open THEN
    agitator_on := FALSE;
  ELSIF run_request THEN
    agitator_on := TRUE;
  ELSE
    agitator_on := FALSE;
  END_IF;

  IF heat_request THEN
    heater_on := TRUE;
  ELSIF agitator_stalled THEN
    heater_on := FALSE;
  ELSE
    heater_on := FALSE;
  END_IF;
  //#ASSERT NOT (agitator_on AND lid_open) : P1
  //#ASSERT NOT (heater_on AND agitator_stalled) : P2
  //#ASSERT NOT (heater_on AND agitator_stalled) : P3
END_FUNCTION_BLOCK
