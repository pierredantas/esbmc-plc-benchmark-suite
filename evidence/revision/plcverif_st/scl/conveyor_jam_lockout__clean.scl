FUNCTION_BLOCK CONVEYOR_CONTROL
  VAR_INPUT
    jam_detected : BOOL;
    run_start : BOOL;
    run_stop : BOOL;
  END_VAR
  VAR
    belt_drive : BOOL;
    jam_this_run : BOOL := FALSE;
    running       : BOOL := FALSE;
  END_VAR

BEGIN
IF run_stop THEN
    running := FALSE;
    jam_this_run := FALSE;
  ELSIF run_start AND NOT jam_this_run THEN
    running := TRUE;
  END_IF;

  IF jam_detected THEN
    jam_this_run := TRUE;
  END_IF;

  IF jam_detected OR jam_this_run OR NOT running THEN
    belt_drive := FALSE;
  ELSE
    belt_drive := TRUE;
  END_IF;
  //#ASSERT NOT (belt_drive AND jam_detected) : P1
  //#ASSERT NOT (belt_drive AND jam_this_run) : P2
  //#ASSERT NOT (belt_drive AND jam_this_run) : P3
END_FUNCTION_BLOCK
