FUNCTION_BLOCK DOOR
  VAR_INPUT
    CloseCmd : BOOL;
    OpenCmd  : BOOL;
    Beam     : BOOL;
    TopLimit : BOOL;
  END_VAR
  VAR_OUTPUT
    Reversing : BOOL;
    MoveDown  : BOOL;
    MoveUp    : BOOL;
  END_VAR

BEGIN
Reversing := (Reversing OR Beam) AND NOT TopLimit;
  MoveDown := CloseCmd AND NOT Beam AND NOT Reversing;
  MoveUp := OpenCmd OR Reversing;
  //#ASSERT NOT (MoveDown AND Beam) : P1
END_FUNCTION_BLOCK
