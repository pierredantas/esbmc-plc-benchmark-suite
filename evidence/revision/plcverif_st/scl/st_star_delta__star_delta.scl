FUNCTION_BLOCK STARTER
  VAR_INPUT
    Call     : BOOL;
    StarDone : BOOL;
    DeadDone : BOOL;
  END_VAR
  VAR_OUTPUT
    Star  : BOOL;
    Delta : BOOL;
  END_VAR

BEGIN
Star := Call AND NOT StarDone;
  Delta := Call AND StarDone AND DeadDone;
  //#ASSERT NOT (Star AND Delta) : P1
END_FUNCTION_BLOCK
